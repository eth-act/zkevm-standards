diff --git a/model/sys/zkvm_io.sail b/model/sys/zkvm_io.sail
new file mode 100644
index 0000000..8a34f2d
--- /dev/null
+++ b/model/sys/zkvm_io.sail
@@ -0,0 +1,62 @@
+// =======================================================================================
+// This Sail RISC-V architecture model, comprising all files and
+// directories except where otherwise noted is subject the BSD
+// two-clause license in the LICENSE file.
+//
+// SPDX-License-Identifier: BSD-2-Clause
+// =======================================================================================
+
+// zkVM I/O device: public output of a zkVM guest.
+//
+//   0x00 VERSION  load, width 8: device version (1.0, semver)
+//   0x08 OUTPUT   store, width 1: append the byte to the public output
+//   0x10 - 0x1f   reserved
+//
+// Any other access raises an access fault.
+
+let ZKVM_IO_VERSION_OFFSET = 0
+let ZKVM_IO_OUTPUT_OFFSET = 8
+let zkvm_io_size : int = 32
+
+// Public output bytes, most recent first.
+register zkvm_output_rev : list(bits(8)) = [||]
+
+/// Called on every byte appended to the public output.
+val zkvm_output_callback = pure {cpp: "zkvm_output_callback"} : bits(8) -> unit
+function zkvm_output_callback(_) = ()
+
+function within_zkvm_io forall 'n, 0 < 'n <= max_mem_access . (Physaddr(addr) : physaddr, width : int('n)) -> bool = {
+  if not(plat_have_zkvm_io) then return false;
+
+  let addr_int = unsigned(addr);
+  let zkvm_io_base_int = unsigned(plat_zkvm_io_base);
+    zkvm_io_base_int <= addr_int
+  & (addr_int + sizeof('n)) <= (zkvm_io_base_int + zkvm_io_size)
+}
+
+val zkvm_io_load : forall 'n, 0 < 'n <= max_mem_access . (MemoryAccessType(mem_payload), physaddr, int('n)) -> MemoryOpResult(bits(8 * 'n))
+function zkvm_io_load(access, Physaddr(paddr), width) = {
+  let VERSION : bits(64) = 0x0000_0000_0001_0000;
+
+  if width != 8 | paddr[2 .. 0] != zeros()
+  then Err(accessFaultFromAccessType(access))
+  else {
+    if paddr == plat_zkvm_io_base + ZKVM_IO_VERSION_OFFSET
+    then Ok(VERSION)
+    else Err(accessFaultFromAccessType(access))
+  }
+}
+
+val zkvm_io_store : forall 'n, 0 < 'n <= max_mem_access . (physaddr, int('n), bits(8 * 'n)) -> MemoryOpResult(bool)
+function zkvm_io_store(Physaddr(paddr), width, data) = {
+  if width != 1
+  then Err(E_SAMO_Access_Fault())
+  else {
+    if paddr == plat_zkvm_io_base + ZKVM_IO_OUTPUT_OFFSET
+    then {
+      zkvm_output_rev = data :: zkvm_output_rev;
+      zkvm_output_callback(data);
+      Ok(true)
+    } else Err(E_SAMO_Access_Fault())
+  }
+}
